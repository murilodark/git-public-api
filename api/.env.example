APP_NAME="Nome da API Local"

# Ambiente da aplicação
# local | homolog | production
APP_ENV=local

# Gere utilizando:
# php artisan key:generate --show
APP_KEY=base64:SUA_APP_KEY_AQUI

# Em ambiente local mantenha true
APP_DEBUG=true


# URL DA APLICAÇÃO LOCAL

# URL utilizada no desenvolvimento local
APP_URL=http://localhost:8080


# LOCALIZAÇÃO

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR


# MODO MANUTENÇÃO

APP_MAINTENANCE_DRIVER=file


# HASH SENHAS

BCRYPT_ROUNDS=12


# LOGS

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# debug | info | warning | error
LOG_LEVEL=debug


# ===============================
# BANCO DE DADOS (MYSQL - DOCKER)
# ===============================
# As credenciais abaixo DEVEM ser exatamente as mesmas
# configuradas no .env da raiz do projeto (ENV_ROOT)

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306

DB_DATABASE=nome_do_banco_local
DB_USERNAME=usuario_local
DB_PASSWORD=senha_local_forte


# ===============================
# SESSÃO / CACHE / FILA
# ===============================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis


# ===============================
# REDIS (DOCKER)
# ===============================

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379


# ===============================
# FILESYSTEM
# ===============================

FILESYSTEM_DISK=local


# ===============================
# MAIL (MAILPIT - DOCKER)
# ===============================

MAIL_MAILER=smtp

MAIL_HOST=mailpit
MAIL_PORT=1025

MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="Nome da API Local"


# ===============================
# FRONT (VITE)
# ===============================

VITE_APP_NAME="Nome da API Local"


# ===============================
# SOCIALITE (GOOGLE)
# ===============================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_REDIRECT_URI="http://localhost:8080/api/v1/auth/google/callback"


# ===============================
# FIREBASE (GOOGLE)
# ===============================

# Caminho relativo dentro da aplicação/container
FIREBASE_CREDENTIALS=storage/app/firebase/firebase-auth.json