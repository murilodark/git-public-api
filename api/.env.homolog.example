APP_NAME="Nome da API Homolog"

# Ambiente da aplicação
# local | homolog | production
APP_ENV=homolog

# Gere utilizando:
# php artisan key:generate --show
APP_KEY=base64:SUA_APP_KEY_AQUI

# Homolog normalmente pode manter true
APP_DEBUG=true


# URLs DA APLICAÇÃO

# URL pública da API
APP_URL=https://api-homolog.seudominio.com.br

# URL pública do frontend
FRONTEND_URL=https://front-homolog.seudominio.com.br

# Nome exibido no frontend/Vite
VITE_APP_NAME="Nome da API Homolog"


# LOCALIZAÇÃO

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR


# MODO MANUTENÇÃO
APP_MAINTENANCE_DRIVER=file


# HASH SENHAS
BCRYPT_ROUNDS=12


# LOGS

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# debug | info | warning | error
LOG_LEVEL=debug


# MYSQL
# As credenciais abaixo DEVEM ser exatamente as mesmas
# configuradas no .env.homolog da raiz do projeto (ENV_ROOT)

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306

DB_DATABASE=nome_do_banco_homolog
DB_USERNAME=usuario_do_banco_homolog
DB_PASSWORD=senha_forte_homolog

# Opcional dependendo da imagem mysql utilizada
DB_ROOT_PASSWORD=senha_root_mysql_homolog


# SESSÃO

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# Utilize o domínio raiz em homolog
SESSION_DOMAIN=.seudominio.com.br


# CACHE / QUEUE

CACHE_STORE=redis
QUEUE_CONNECTION=redis


# REDIS

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379


# STORAGE

FILESYSTEM_DISK=local


# E-MAIL

# smtp | log | ses | mailgun
MAIL_MAILER=log

MAIL_FROM_ADDRESS=no-reply@seudominio.com.br
MAIL_FROM_NAME="Nome da API Homolog"


# GOOGLE OAUTH

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_REDIRECT_URI=https://api-homolog.seudominio.com.br/api/v1/auth/google/callback


# FIREBASE

# Caminho relativo dentro do container/aplicação
FIREBASE_CREDENTIALS=storage/app/firebase/firebase-auth.json