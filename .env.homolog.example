COMPOSE_PROJECT_NAME=nome_do_projeto_api_production

# DOMÍNIOS
# Domínio público da API usado pelo Traefik
TRAEFIK_HOST=api-production.seudominio.com.br

# Domínio principal da aplicação API
APP_DOMAIN=api-production.seudominio.com.br

# Domínio do frontend que irá consumir esta API
FRONTEND_DOMAIN=front-production.seudominio.com.br

# Domínio raiz do projeto
ROOT_DOMAIN=seudominio.com.br


# NGINX
# Server name utilizado na configuração do Nginx
NGINX_SERVER_NAME=api-production.seudominio.com.br


# PORTAS EXTERNAS
# Em homolog/production recomenda-se NÃO expor MySQL, Redis ou Nginx diretamente.
# O acesso público deve acontecer preferencialmente via Traefik nas portas 80/443.
# Caso precise expor alguma porta para debug ou acesso controlado, informe uma porta disponível.

# MYSQL
DB_EXTERNAL_PORT=

# NGINX
NGINX_PORT=

# REDIS
REDIS_EXTERNAL_PORT=


# BANCO DE DADOS MYSQL
# Nome do banco de dados da aplicação
DB_DATABASE=nome_do_banco_production

# Usuário do banco de dados da aplicação
DB_USERNAME=usuario_do_banco_production

# Senha do usuário da aplicação
DB_PASSWORD=senha_forte_do_usuario_production

# Senha do usuário root do MySQL
DB_ROOT_PASSWORD=senha_forte_root_mysql_production


# XDEBUG
# Em produção mantenha desativado
XDEBUG_MODE=off


