# ======================================
# Laravel Core (API)
# ======================================
/api/vendor/
/api/node_modules/
/api/public/storage
/api/public/hot
/api/storage/*.key
/api/.phpunit.result.cache

# ======================================
# Ambiente
# ======================================
# Use .env.example e api/.env.example como base
.env
.env.*
!.env.example

/api/.env
/api/.env.*
!/api/.env.example

/mcp-pescala/
/docs-privado/

# ======================================
# Cache, logs e temporários
# ======================================
/api/storage/framework/cache/*
/api/storage/framework/sessions/*
/api/storage/framework/testing/*
/api/storage/framework/views/*
/api/storage/logs/*
!/api/storage/logs/.gitignore

# ======================================
# Docker & Banco de Dados
# ======================================
# Ignorar apenas dados persistentes, mantendo configs versionadas
/docker/mysql/*
/docker/redis/*
/docker/*/logs/*

# Manter configurações Docker/Nginx/PHP
!/docker/nginx/conf.d/*.conf
!/docker/mysql-backup/*.sh
!/docker/php/*.ini

# Backups locais
/backups/*.sql
/backups/*.gz

*.sock
*.lock
mysql.sock

# ======================================
# Arquivos pessoais / locais
# ======================================
comando-docker.txt
*.sql
*.sqlite

# ======================================
# IDEs e SO
# ======================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ======================================
# Build / Testes
# ======================================
dist/
coverage/