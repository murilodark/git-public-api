# ======================================
# Laravel Core (API)
# ======================================
/api/vendor/
/api/node_modules/
/api/public/storage
/api/public/hot
/api/.phpunit.result.cache

# Correção: Garante que chaves em subpastas do storage também sejam ignoradas
/api/storage/**/*.key

# ======================================
# Ambiente
# ======================================
.env
.env.*
!.env.example

/api/.env
/api/.env.*
!/api/.env.example

/mcp-pescala/
/docs-privado/

# ======================================
# Cache, logs e temporários (Preservando a estrutura para o Docker)
# ======================================
/api/storage/framework/cache/*
/api/storage/framework/sessions/*
/api/storage/framework/testing/*
/api/storage/framework/views/*
/api/storage/logs/*

# Mantém os arquivos estruturais ocultos para o Git criar as pastas vazias no deploy
!/api/storage/framework/cache/.gitignore
!/api/storage/framework/sessions/.gitignore
!/api/storage/framework/testing/.gitignore
!/api/storage/framework/views/.gitignore
!/api/storage/logs/.gitignore

# ======================================
# Docker & Banco de Dados
# ======================================
/docker/mysql/*
/docker/redis/*
/docker/*/logs/*

!/docker/nginx/conf.d/*.conf
!/docker/mysql-backup/*.sh
!/docker/php/*.ini

/backups/*.sql
/backups/*.gz

*.sock
mysql.sock

# Correção: Impede que o *.lock genérico bloqueie o composer.lock do Laravel
*.lock
!/api/composer.lock

# ======================================
# Arquivos pessoais / locais / IDEs
# ======================================
comando-docker.txt
*.sql
*.sqlite
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ======================================
# Build / Testes
# ======================================
dist/
coverage/
